{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-research.local/schemas/student-mentor-acks.schema.json",
  "title": "Student Mentor Acknowledgements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "studentId", "updatedAt", "acknowledgements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "studentId": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": ["string", "null"] },
    "acknowledgements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reviewId", "reviewSha256", "status", "recordedAt", "note", "evidenceRefs"],
        "properties": {
          "reviewId": { "type": "string", "minLength": 1 },
          "reviewSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "status": { "enum": ["observed", "applied", "challenged"] },
          "recordedAt": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 },
          "evidenceRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
